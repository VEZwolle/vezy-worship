{
  "name": "vezy-worship",
  "version": "3.0.0",
  "description": "Presentatiesoftware voor beamer én livestream",
  "productName": "VezyWorship",
  "author": "Jan-Paul Kleemans jpkleemans@gmail.com & Jeroen Faber",
  "type": "module",
  "private": true,
  "repository": "github:VEZwolle/vezy-worship",
  "scripts": {
    "lint": "eslint -c ./eslint.config.js './src*/**/*.{js,cjs,mjs,vue}'",
    "test": "echo \"No test specified\" && exit 0",
    "serve": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare --silent",
    "electron:serve": "quasar dev -m electron",
    "electron:build": "quasar build -m electron -P never",
    "electron:build-debug": "quasar build -m electron -d -P never",
    "electron:release": "quasar build -m electron -P always",
    "api:serve": "firebase emulators:start",
    "api:serve-data": "firebase emulators:start --import ./dev/export-firestore",
    "api:get-data": "powershell ./dev/emulator-get-data.ps1",
    "api:update-data": "powershell ./dev/emulator-update-data.ps1"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "@zip.js/zip.js": "^2.24.0",
    "axios": "^1.21.0",
    "core-js": "^3.51.0",
    "dayjs": "^1.11.23",
    "idb-keyval": "^6.3.0",
    "lodash": "^4.18.1",
    "nanoid": "^6.0.2",
    "osc-min": "^2.1.2",
    "pinia": "^4.1.0",
    "pinia-shared-state": "2.1.0",
    "vue-three-shortkey": "^4.0.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "vite-plugin-checker": "^0.14.5",
    "vue-eslint-parser": "^10.4.1",
    "@quasar/app-vite": "^3.10.3",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12",
    "npm": ">= 11.2.0",
    "yarn": ">= 1.21.1"
  }
}
